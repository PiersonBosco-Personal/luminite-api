APP_NAME=Luminite
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite in-memory — matches phpunit.xml; no database server needed in CI
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4

REVERB_APP_ID=testing
REVERB_APP_KEY=testing
REVERB_APP_SECRET=testing
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
